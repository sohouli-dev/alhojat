---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <main
    class="splash-page min-h-screen w-full bg-cover bg-center bg-no-repeat"
    aria-label="Alhojat"
  >
    <div class="relative z-10 flex min-h-screen flex-col items-center justify-center px-4 py-10">
      <h1 class="sr-only">Alhojat</h1>

      <!-- دکمه‌های انتخاب زبان را بعداً اینجا اضافه می‌کنیم -->
    </div>
  </main>
</Layout>

<style>
  .splash-page {
    background-image: url('/images/splash-pc.jpg');
  }

  @media (max-width: 767px) {
    .splash-page {
      background-image: url('/images/splash-mobile.jpg');
    }
  }
</style>
